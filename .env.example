DATABASE_URL=postgres://nstream:nstream@localhost:5432/nstream
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
S3_BUCKET=nstream-media
MINIO_ROOT_USER=nstream-local
MINIO_ROOT_PASSWORD=replace-with-at-least-8-characters
GPU_WORKER_COUNT=4
API_PORT=8080
RUST_LOG=info
# Local development storage adapter. Place source media at
# $NSTREAM_LOCAL_MEDIA_DIR/<bucket>/<key>.
NSTREAM_LOCAL_MEDIA_DIR=./media-input
NSTREAM_OUTPUT_DIR=./media-output
JOB_WORKER_COUNT=2
# Set true outside local development and issue NSTREAM_BOOTSTRAP_API_KEY once.
NSTREAM_AUTH_REQUIRED=true
NSTREAM_BOOTSTRAP_API_KEY=replace-with-a-long-random-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-a-unique-long-secret
NSTREAM_RATE_LIMIT_PER_MINUTE=60
# Whisper model already downloaded for local ASR; Piper needs a per-language model.
WHISPER_MODEL_PATH=models/ggml-base.bin
# TRANSLATION_API_URL=http://translation:5000/translate
# PIPER_BIN=/usr/local/bin/piper
# PIPER_VOICE_EN=/models/en_US-lessac-medium.onnx
# LIPSYNC_API_URL=https://your-gpu-model-service/v1/lipsync # accepts video/mp4 with X-NStream-Target-Language
# LIPSYNC_API_KEY=replace-with-provider-key
# LIPSYNC_REQUIRED=true
# NSTREAM_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# NSTREAM_ALLOW_EXTERNAL_INPUT=false
# CORS_ALLOW_ORIGIN=https://app.example.com
# NSTREAM_ALLOW_INSECURE_WEBHOOKS=false
# NSTREAM_LIVE_HLS_DIR=./live-hls
